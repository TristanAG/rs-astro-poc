---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { useStoryblokApi, getPayload } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const storyblokApi = useStoryblokApi();
const slug = Astro.params.slug || 'home';

const payload = await getPayload({
  locals: Astro.locals,
});

const [{ data: settingsData }, story] = await Promise.all([
  storyblokApi.get('cdn/stories/site-settings', { version: 'draft' }),
  payload?.story ??
    storyblokApi
      .get(`cdn/stories/${slug}`, { version: 'draft' })
      .then(({ data }) => data.story),
]);

const settings = settingsData.story.content;
---

<Layout title={story.name} settings={settings}>
  <StoryblokComponent blok={story.content} />
</Layout>
