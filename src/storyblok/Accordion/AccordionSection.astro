---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok } = Astro.props;
---

<section
  {...storyblokEditable(blok)}
  class:list={['accordion-section', blok.section_id && 'target', blok.mobile_nav_target && 'mobmenu_target']}
  id={blok.section_id?.trim() || undefined}
>
  {blok.heading && <h3>{blok.heading}</h3>}

  <div class="accordion" data-accordion>
    {blok.items?.map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
</section>

<style>
  h3 {
    font-size: 30px;
    line-height: 42px;
    text-align: center;
    margin-bottom: 6px;
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest('[data-accordion-trigger]');
    if (!trigger) return;

    const item = trigger.closest('[data-accordion-item]');
    const panel = item?.querySelector('[data-accordion-panel]') as HTMLElement | null;
    if (!item || !panel) return;

    const isOpen = trigger.getAttribute('aria-expanded') === 'true';

    trigger.setAttribute('aria-expanded', String(!isOpen));
    item.classList.toggle('is-open', !isOpen);
    panel.style.maxHeight = isOpen ? '0px' : `${panel.scrollHeight}px`;
  });
</script>
