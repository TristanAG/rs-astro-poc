---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

const { blok } = Astro.props;
const content = renderRichText(blok.content);
---

<div class="accordion-item" data-accordion-item {...storyblokEditable(blok)}>
  <button class="accordion-trigger" type="button" data-accordion-trigger aria-expanded="false">
    <span class="accordion-title">{blok.title}</span>
    <span class="accordion-arrow" aria-hidden="true"></span>
  </button>

  <div class="accordion-panel" data-accordion-panel>
    <div class="accordion-panel-inner" set:html={content}></div>
  </div>
</div>

<style>
  .accordion-trigger {
    position: relative;
    width: 100%;
    display: block;
    padding: 1rem 2.75rem 1rem 0;
    margin: 0;
    background: transparent;
    border: 0;
    color: inherit;
    text-align: left;
    cursor: pointer;
    font: inherit;
    font-weight: 500;
    font-size: 26px;
    line-height: 26px;
    color: #000;
    box-shadow: none;
    outline: none;
    --pico-box-shadow: none;
    --pico-button-box-shadow: none;
    --pico-button-hover-box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
  }

  .accordion-trigger:hover,
  .accordion-trigger:active,
  .accordion-trigger:focus,
  .accordion-trigger:focus-visible {
    background: transparent;
    border: 0;
    box-shadow: none;
    outline: none;
    color: #000;
    --pico-box-shadow: none;
  }

  .accordion-title {
    display: block;
    padding-right: 0.5rem;
  }

  .accordion-arrow {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 3px solid #29b6dc;
    background: transparent;
    color: #29b6dc;
    box-sizing: border-box;
  }

  .accordion-arrow::before {
    content: '';
    display: block;
    width: 0;
    height: 0;
    margin-top: 2px;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-top: 8px solid currentColor;
    transition: transform 200ms ease;
  }

  .accordion-item.is-open .accordion-arrow::before {
    transform: rotate(180deg);
  }

  .accordion-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 250ms ease;
  }

  .accordion-panel-inner {
    padding-bottom: 1rem;
  }
</style>
