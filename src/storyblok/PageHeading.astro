---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;
---

<section {...storyblokEditable(blok)}>
  <h1>{blok.title}</h1>
  <p class="subtext">{blok.subtext}</p>
</section>

<style>
  h1 {
    text-align: center;
  }
  .subtext {
    text-align: center;
    font-size: 12px;
  }
</style>