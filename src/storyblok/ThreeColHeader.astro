---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

const columns = [
  { image: blok.image_one, text: blok.text_one },
  { image: blok.image_two, text: blok.text_two },
  { image: blok.image_three, text: blok.text_three },
];
---

<section {...storyblokEditable(blok)} class="three-col-header">
  {blok.title && <h2 class="three-col-header-title">{blok.title}</h2>}

  <div class="three-col-header-grid">
    {columns.map((column) => (
      <div class="three-col-header-item">
        {column.image?.filename && (
          <img
            class="three-col-header-image"
            src={column.image.filename}
            alt={column.image.alt || ''}
          />
        )}
        {column.text && <p class="three-col-header-text">{column.text}</p>}
      </div>
    ))}
  </div>
</section>

<style>
  .three-col-header {
    width: 100%;
    background-color: #7a93c2;
    padding: 9px 0 9px;
  }

  .three-col-header-title {
    font-weight: 500;
    font-size: 24px;
    line-height: 24px;
    color: #000;
    text-align: center;
    margin-bottom: 17px;
  }

  .three-col-header-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: min(100%, 650px);
    height: 140px;
    margin: 0 auto;
  }

  .three-col-header-item {
    display: flex;
    flex-direction: column;
    align-items: center;

    text-align: center;
    gap: 0.5rem;
    background-color: #fff;
    padding: 0.5rem;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    width: 100%;
    height: 140px;
    border-radius: 5px;
  }

  .three-col-header-image {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 70px;
    height: auto;
    object-fit: contain;
  }

  .three-col-header-text {
    margin: 0;
    font-size: 0.875rem;
  }

  @media (max-width: 767px) {
    .three-col-header-grid {
      width: 100%;
      height: auto;
      padding: 0 10px;
    }

    .three-col-header-item {
      height: auto;
      aspect-ratio: 210 / 140;
      padding: 0.35rem 0.25rem;
      gap: 0.25rem;
    }

    .three-col-header-image {
      flex: 1 1 0;
      min-height: 0;
      max-height: 55%;
      max-width: 90%;
    }

    .three-col-header-text {
      flex-shrink: 0;
      font-size: 12px;
      line-height: 18px;
      letter-spacing: -0.5px;
    }
  }

  @media (max-width: 415px) {
    .three-col-header-item {
      aspect-ratio: auto;
      height: auto;
      overflow: visible;
    }

    .three-col-header-image {
      flex: 0 0 auto;
      width: 50px;
      max-width: 50px;
      height: auto;
      max-height: none;
    }
  }
</style>
