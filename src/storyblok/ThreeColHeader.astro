---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

const columns = [
  { image: blok.image_one, text: blok.text_one, anchor: blok.anchor_one?.trim() },
  { image: blok.image_two, text: blok.text_two, anchor: blok.anchor_two?.trim() },
  { image: blok.image_three, text: blok.text_three, anchor: blok.anchor_three?.trim() },
];
---

<section {...storyblokEditable(blok)} class="three-col-header">
  {blok.title && <h2 class="three-col-header-title">{blok.title}</h2>}

  <div class="three-col-header-grid">
    {columns.map((column) => {
      const content = (
        <>
          {column.image?.filename && (
            <img
              class="three-col-header-image"
              src={column.image.filename}
              alt={column.image.alt || ''}
            />
          )}
          {column.text && <p class="three-col-header-text">{column.text}</p>}
        </>
      );

      return column.anchor ? (
        <a
          class="three-col-header-item"
          href={`#${column.anchor}`}
          data-section-id={column.anchor}
        >
          {content}
        </a>
      ) : (
        <div class="three-col-header-item">{content}</div>
      );
    })}
  </div>
</section>

<style>
  .three-col-header {
    width: 100%;
    background-color: #7a93c2;
    padding: 9px 0 9px;
  }

  .three-col-header-title {
    font-weight: 500;
    font-size: 24px;
    line-height: 24px;
    color: #000;
    text-align: center;
    margin-bottom: 17px;
  }

  .three-col-header-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: min(100%, 650px);
    height: 140px;
    margin: 0 auto;
  }

  .three-col-header-item {
    display: grid;
    grid-template-rows: 1fr 1fr;
    justify-items: center;
    text-align: center;
    background-color: #fff;
    padding: 0.5rem;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    width: 100%;
    height: 140px;
    border-radius: 5px;
  }

  a.three-col-header-item {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  a.three-col-header-item:hover {
    background-color: #f5f7fb;
  }

  a.three-col-header-item:focus-visible {
    outline: 3px solid rgba(29, 48, 76, 0.35);
    outline-offset: 2px;
  }

  .three-col-header-image {
    display: block;
    align-self: start;
    width: auto;
    max-width: 100%;
    max-height: 100%;
    height: auto;
    object-fit: contain;
  }

  .three-col-header-text {
    align-self: start;
    margin: 12px 0 0 0;
    font-size: .875rem;
    width: 160px;
    line-height: 22px;
  }

  @media (max-width: 767px) {
    .three-col-header-grid {
      width: 100%;
      padding: 0 10px;
    }

    .three-col-header-item {
      padding: 0.35rem 0.25rem;
    }

    .three-col-header-image {
      max-width: 90%;
    }

    .three-col-header-text {
      width: 100%;
      max-width: 100%;
      font-size: 12px;
      line-height: 18px;
      letter-spacing: -0.5px;
    }
  }
</style>
