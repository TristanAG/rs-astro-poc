---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

const columns = [
  { image: blok.image_one, text: blok.text_one },
  { image: blok.image_two, text: blok.text_two },
  { image: blok.image_three, text: blok.text_three },
];
---

<section {...storyblokEditable(blok)} class="three-col-header">
  {blok.title && <h2 class="three-col-header-title">{blok.title}</h2>}

  <div class="three-col-header-grid">
    {columns.map((column) => (
      <div class="three-col-header-item">
        {column.image?.filename && (
          <img
            class="three-col-header-image"
            src={column.image.filename}
            alt={column.image.alt || ''}
          />
        )}
        {column.text && <p class="three-col-header-text">{column.text}</p>}
      </div>
    ))}
  </div>
</section>

<style>
  .three-col-header {
    width: 100%;
    background-color: #7a93c2;
    padding: 2rem;
    padding-bottom: 18px;
  }

  .three-col-header-title {
    margin: 0 0 1.5rem;
    text-align: center;
  }

  .three-col-header-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    width: 767px;
    height: 140px;
    margin: 0 auto;
  }

  .three-col-header-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.5rem;
    background-color: #fff;
    padding: 0.5rem;
    min-height: 0;
    overflow: hidden;
  }

  .three-col-header-image {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 70px;
    height: auto;
    object-fit: contain;
  }

  .three-col-header-text {
    margin: 0;
    font-size: 0.875rem;
  }

  @media (max-width: 800px) {
    .three-col-header-grid {
      width: 100%;
      height: auto;
      grid-template-columns: 1fr;
    }

    .three-col-header-image {
      max-height: none;
    }
  }
</style>
