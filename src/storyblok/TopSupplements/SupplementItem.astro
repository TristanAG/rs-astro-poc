---
import { storyblokEditable, renderRichText } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok } = Astro.props;
const product_image = blok.product_image;
const why_we_chose_it = renderRichText(blok.why_we_chose_it);

const ratingBars = [
  { label: 'Predicted Effectiveness', value: blok.predicted_effectiveness },
  { label: 'Ingredient Quality', value: blok.ingredient_quality },
  { label: 'Value', value: blok.value },
  { label: 'Return Policy', value: blok.return_policy },
  { label: 'User Rating', value: blok.user_rating },
];

const toBarWidth = (value) => {
  const numeric = Number(value);
  if (Number.isNaN(numeric)) return 0;
  return `${Math.min(Math.max(numeric, 0), 10) * 10}%`;
};
---

<article {...storyblokEditable(blok)} class="supplement-item">
  {blok.title && <h3 class="supplement-item-title">{blok.title}</h3>}

  <div class="supplement-item-top">
    <div class="supplement-item-image">
      {product_image?.filename && (
        <img
          src={product_image.filename}
          alt={product_image.alt || blok.title || ''}
        />
      )}
    </div>

    <div class="supplement-item-bars">
      {ratingBars.map((bar) => (
        <div class="rating-bar">
          <div class="rating-bar-label">
            <span>{bar.label}</span>
            <span>{bar.value ?? 0}/10</span>
          </div>
          <div class="rating-bar-track" aria-hidden="true">
            <div class="rating-bar-fill" style={`width: ${toBarWidth(bar.value)};`} />
          </div>
        </div>
      ))}
    </div>

    <div class="supplement-item-grade">
      {blok.overall_crade && (
        <p class="overall-grade">{blok.overall_crade}</p>
      )}
    </div>
  </div>

  <section class="supplement-item-pros">
    <h4>Pros</h4>
    {blok.pros?.map((item) => (
      <StoryblokComponent blok={item} icon={blok.pro_asset} />
    ))}
  </section>

  <section class="supplement-item-cons">
    <h4>Cons</h4>
    {blok.cons?.map((item) => (
      <StoryblokComponent blok={item} icon={blok.con_asset} />
    ))}
  </section>

  {blok.why_we_chose_it && (
    <div class="supplement-item-why" set:html={why_we_chose_it} />
  )}
</article>

<style>
  .supplement-item {
    margin-bottom: 2.5rem;
  }

  .supplement-item-title {
    margin-bottom: 1rem;
  }

  .supplement-item-top {
    display: grid;
    grid-template-columns: 1fr 1.5fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  .supplement-item-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .supplement-item-bars {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rating-bar-label {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    font-size: 0.9rem;
  }

  .rating-bar-track {
    width: 100%;
    height: 0.5rem;
    background: color-mix(in srgb, currentColor 15%, transparent);
    overflow: hidden;
  }

  .rating-bar-fill {
    height: 100%;
    background: currentColor;
  }

  .supplement-item-grade {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .overall-grade {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
  }

  .supplement-item-pros,
  .supplement-item-cons {
    margin-top: 1.5rem;
  }

  .supplement-item-pros h4,
  .supplement-item-cons h4 {
    margin-bottom: 0.75rem;
  }

  .supplement-item-why {
    margin-top: 1.5rem;
  }

  @media (max-width: 768px) {
    .supplement-item-top {
      grid-template-columns: 1fr;
    }
  }
</style>
