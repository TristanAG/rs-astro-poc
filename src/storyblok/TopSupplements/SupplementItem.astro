---
import { storyblokEditable, renderRichText } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok, rank = 1 } = Astro.props;
const product_image = blok.product_image;
const why_we_chose_it = renderRichText(blok.why_we_chose_it);

const categoryRatings = [
  { label: 'Predicted Effectiveness', value: blok.predicted_effectiveness },
  { label: 'Ingredient Quality', value: blok.ingredient_quality },
  { label: 'Value', value: blok.value },
  { label: 'Return Policy', value: blok.return_policy },
  { label: 'User Rating', value: blok.user_rating },
];

const validRatings = categoryRatings
  .map(({ value }) => Number(value))
  .filter((value) => Number.isFinite(value));
const overallRating = validRatings.length
  ? validRatings.reduce((total, value) => total + value, 0) / validRatings.length
  : 0;
const ratingBars = [
  { label: 'OVERALL RATING', value: overallRating },
  ...categoryRatings,
];
const grade = blok.overall_crade || '';
const gradeCircleBackground =
  'https://a.storyblok.com/f/293683996317857/165x165/1c304a7e88/prg-01_a_plus_100.webp';
const resolveLinkHref = (link: unknown) => {
  if (!link) return '';
  if (typeof link === 'string') return link.trim();
  if (typeof link !== 'object') return '';

  const storyblokLink = link as {
    linktype?: string;
    email?: string;
    url?: string;
    cached_url?: string;
    target?: string;
  };

  if (storyblokLink.linktype === 'email') {
    const email = storyblokLink.email ?? storyblokLink.url ?? '';
    return email ? `mailto:${email}` : '';
  }
  if (storyblokLink.linktype === 'story') {
    const slug = storyblokLink.cached_url || storyblokLink.url || '';
    if (!slug) return '';
    return slug.startsWith('/') ? slug : `/${slug}`;
  }
  return (storyblokLink.url || storyblokLink.cached_url || '').trim();
};

const productLink = blok.product_link;
const productUrl = resolveLinkHref(productLink);
const productLinkTarget =
  typeof productLink === 'object' &&
  productLink !== null &&
  productLink.target === '_blank'
    ? '_blank'
    : undefined;
const productLinkRel = productLinkTarget ? 'noopener noreferrer' : undefined;
const productLinkAttrs = productLinkTarget
  ? { target: productLinkTarget, rel: productLinkRel }
  : {};
const CardTag = productUrl ? 'a' : 'div';

const formatRating = (value: unknown) => {
  const numeric = Number(value);
  return Number.isFinite(numeric) ? numeric.toFixed(1) : '0.0';
};

const toBarWidth = (value: unknown) => {
  const numeric = Number(value);
  if (Number.isNaN(numeric)) return 0;
  return `${Math.min(Math.max(numeric, 0), 10) * 10}%`;
};

const pros = blok.pros ?? [];
const cons = blok.cons ?? [];
const prosSplitIndex = Math.ceil(pros.length / 2);
const prosLeft = pros.slice(0, prosSplitIndex);
const prosRight = pros.slice(prosSplitIndex);
const consSplitIndex = Math.ceil(cons.length / 2);
const consLeft = cons.slice(0, consSplitIndex);
const consRight = cons.slice(consSplitIndex);
const remarks = blok.remarks || blok.disclaimer || '';
const showChoose = why_we_chose_it || blok.supplement_subtext || remarks || productUrl;
---

<article {...storyblokEditable(blok)} class="supplement-item">
  <CardTag
    class:list={['supplement-item-card', { 'supplement-item-link': CardTag === 'a' }]}
    {...CardTag === 'a' ? { href: productUrl, ...productLinkAttrs } : {}}
  >
    {blok.title && (
      <h3 class="supplement-item-mobile-title">#{rank} {blok.title}</h3>
    )}

    <div class="supplement-item-product-grade">
      <div class="supplement-item-image">
        {product_image?.filename && (
          <img
            src={product_image.filename}
            alt={product_image.alt || blok.title || ''}
          />
        )}
      </div>

      <div class="supplement-item-grade">
        <div
          class="grade-circle"
          style={`background-image: url('${gradeCircleBackground}');`}
        >
          <span class="grade-value">{grade}</span>
          <span class="grade-label">Overall Grade</span>
        </div>
      </div>
    </div>

    <div class="supplement-item-ratings">
      {blok.title && (
        <h3 class="supplement-item-desktop-title">#{rank}. {blok.title}</h3>
      )}
      <ul>
        {ratingBars.map((bar, index) => (
          <li class:list={{ 'active-rating': index === 0 }}>
            <div class="rating-summary">
              <span class="rating-label">{bar.label}</span>
              <span class="rating-track">
                <span
                  class="rating-fill"
                  style={`width: ${toBarWidth(bar.value)};`}
                >
                  {formatRating(bar.value)}/10
                </span>
              </span>
            </div>
            <div class="mobile-rating-track" aria-hidden="true">
              <span
                class="mobile-rating-fill"
                style={`width: ${toBarWidth(bar.value)};`}
              ></span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </CardTag>

  <div class="supplement-item-details">
    {pros.length > 0 && (
      <div class="pros">
        <h5>PROS</h5>
        {prosRight.length > 0 ? (
          <>
            <div class="left">
              <ul>
                {prosLeft.map((item: any) => (
                  <StoryblokComponent blok={item} />
                ))}
              </ul>
            </div>
            <div class="right">
              <ul>
                {prosRight.map((item: any) => (
                  <StoryblokComponent blok={item} />
                ))}
              </ul>
            </div>
            <div class="clearfix"></div>
          </>
        ) : (
          <div class="full-width-div">
            <ul>
              {prosLeft.map((item: any) => (
                <StoryblokComponent blok={item} />
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    {cons.length > 0 && (
      <div class="cons">
        <h5>CONS</h5>
        {consRight.length > 0 ? (
          <>
            <div class="left">
              <ul>
                {consLeft.map((item: any) => (
                  <StoryblokComponent blok={item} />
                ))}
              </ul>
            </div>
            <div class="right">
              <ul>
                {consRight.map((item: any) => (
                  <StoryblokComponent blok={item} />
                ))}
              </ul>
            </div>
            <div class="clearfix"></div>
          </>
        ) : (
          <div class="full-width-div">
            <ul>
              {consLeft.map((item: any) => (
                <StoryblokComponent blok={item} />
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    {showChoose && (
      <div class="choose">
        <h5>Why We Chose It</h5>
        {why_we_chose_it && (
          <div class="choose-copy" set:html={why_we_chose_it} />
        )}
        {blok.supplement_subtext && (
          <small class="supplement-subtext">{blok.supplement_subtext}</small>
        )}
        {remarks && <p class="remarks">{remarks}</p>}
        {productUrl && (
          <div class="choose-cta">
            <a class="choose-cta__link" href={productUrl} {...productLinkAttrs}>
              FIND OUT MORE &gt;&gt;
            </a>
          </div>
        )}
      </div>
    )}
  </div>
</article>

<style>
  .supplement-item {
    max-width: 997px;
    margin: 20px auto 40px;
    padding: 0;
  }

  .supplement-item-card {
    display: grid;
    grid-template-columns: 220px 560px 1fr;
    overflow: hidden;
    color: inherit;
    border: 2px solid #eaeaea;
    border-radius: 5px;
    text-decoration: none;
  }

  .supplement-item-link {
    cursor: pointer;
  }

  .supplement-item-product-grade {
    display: contents;
  }

  .supplement-item-image {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    padding: 8px 4px;
  }

  .supplement-item-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .supplement-item-ratings {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
    border-right: 2px solid #eaeaea;
    border-left: 2px solid #eaeaea;
  }

  .supplement-item-desktop-title {
    display: block;
    margin: 0;
    padding: 15px 8px 7px;
    color: #000;
    background: #f8f8f8;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.2;
    text-align: left;
  }

  .supplement-item-ratings ul {
    margin: 0;
    padding: 5px;
    padding-left: 0;
    list-style: none;
    list-style-type: none;
  }

  .supplement-item-ratings li {
    margin: 0;
    padding: 5px;
    list-style: none;
    border-bottom: 1px solid #a1a1a1;
  }

  .supplement-item-ratings li:last-child {
    border-bottom: 0;
  }

  .supplement-item-ratings li.active-rating {
    padding: 2px;
    border: 3px solid #921414;
  }

  .rating-summary {
    display: flex;
    align-items: stretch;
  }

  .rating-label {
    width: 49%;
    color: #000;
    font-size: 19px;
    font-weight: 600;
    line-height: 25px;
  }

  .rating-track {
    width: 51%;
    overflow: hidden;
    background: #e0e0e0;
  }

  .rating-fill {
    display: block;
    min-width: max-content;
    box-sizing: border-box;
    height: 100%;
    padding-left: 5px;
    color: #fff;
    background: #921414;
    font-size: 17px;
    font-weight: 600;
    line-height: 25px;
  }

  .mobile-rating-track {
    display: none;
  }

  .supplement-item-grade {
    grid-column: 3;
    grid-row: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-width: 0;
    padding: 15px 12px 20px;
    text-align: center;
  }

  .grade-circle {
    display: flex;
    width: 175px;
    height: 175px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 100%;
    font-family: Arial, sans-serif;
    text-align: center;
  }

  @media (max-width: 639px) {
    .grade-circle {
      justify-content: flex-start;
      padding-top: 8px;
    }
  }

  .grade-value {
    color: #000;
    font-size: 48px;
    font-weight: 700;
    line-height: 1;
    transform: translateY(-6px);
  }

  .grade-label {
    color: #000;
    font-size: 14px;
    line-height: 1.2;
    transform: translateY(-6px);
  }

  .supplement-item-mobile-title {
    display: none;
  }

  .supplement-item-details {
    margin-top: 12px;
    border: 2px solid #a1a1a1;
  }

  .supplement-item-details .full-width-div {
    width: 100%;
    float: none;
  }

  .supplement-item-details .pros {
    padding: 12px 15px;
    border-bottom: 2px solid #a1a1a1;
  }

  .supplement-item-details .pros h5,
  .supplement-item-details .cons h5,
  .supplement-item-details .choose h5 {
    position: relative;
    margin: 0;
    color: #000;
    font-size: 36px;
    font-weight: 500;
    line-height: 36px;
    text-align: center;
  }

  .supplement-item-details .pros h5 {
    margin-bottom: 28px;
  }

  .supplement-item-details .cons h5 {
    margin-bottom: 17px;
  }

  .supplement-item-details .choose h5 {
    margin-bottom: 22px;
  }

  .supplement-item-details h5::after {
    position: absolute;
    bottom: -10px;
    left: 50%;
    width: 41px;
    height: 2px;
    transform: translateX(-50%);
    background: #a1a1a1;
    content: '';
  }

  .supplement-item-details .left {
    width: 51%;
    float: left;
  }

  .supplement-item-details .right {
    width: 45%;
    float: right;
    margin-left: 21px;
  }

  .supplement-item-details ul {
    margin: 0;
    padding-left: 0;
    list-style: none;
  }

  .supplement-item-details .pros :global(ul li),
  .supplement-item-details .cons :global(ul li) {
    position: relative;
    list-style: none;
    margin-bottom: 25px;
    color: #000;
    font-size: 19px;
    font-weight: 400;
    letter-spacing: -1px;
    line-height: 34.81px;
  }

  .supplement-item-details .pros :global(ul li:last-child),
  .supplement-item-details .cons :global(ul li:last-child) {
    margin-bottom: 0;
  }

  .supplement-item-details .pros :global(ul li span) {
    font-weight: 700;
  }

  .supplement-item-details .cons {
    padding: 12px 15px;
    border-bottom: 2px solid #a1a1a1;
  }

  .supplement-item-details .choose {
    padding: 12px 15px;
  }

  .supplement-item-details .choose-copy :global(p) {
    margin: 0 0 35px;
    color: #000;
    font-size: var(--paragraph-font-size, 19px);
    font-weight: 400;
    line-height: 28px;
    letter-spacing: 0;
  }

  .supplement-item-details .choose-copy :global(p:last-child) {
    margin-bottom: 35px;
  }

  .supplement-item-details .choose-copy :global(strong) {
    font-weight: 700;
  }

  .supplement-item-details .choose .supplement-subtext {
    display: block;
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: calc(19px * 0.85);
    line-height: 26px;
    color: #000;
    margin: 0 0 35px;
  }

  .supplement-item-details .choose p.remarks {
    margin-top: -9px;
    margin-bottom: 37px;
    color: #000;
    font-size: 14px;
    font-weight: 400;
    line-height: 18px;
  }

  .supplement-item-details .choose-cta {
    margin: 0;
  }

  .supplement-item-details .choose-cta__link {
    display: table;
    margin: 0 auto 20px;
    padding: 16px 38px 16px 49px;
    border: none;
    border-radius: 10px;
    background: #c33;
    color: #fff;
    font-size: 30px;
    font-weight: 600;
    line-height: 30px;
    text-decoration: none;
  }

  .supplement-item-details br {
    display: none;
  }

  .clearfix::after {
    display: block;
    clear: both;
    content: '';
  }

  @media (max-width: 767px) {
    .supplement-item-details .left,
    .supplement-item-details .right {
      float: none;
      width: 100%;
      margin-left: inherit;
    }

    .supplement-item-details .right {
      margin-top: 10px;
    }

    .supplement-item-details {
      margin-bottom: 15px;
    }

    .supplement-item-details .choose h5 {
      font-size: 30px;
    }
  }

  @media (max-width: 639px) {
    .supplement-item-product-grade {
      margin-bottom: 10px;
      border: 2px solid #ccc;
    }

    .supplement-item-grade {
      display: flex;
      flex-direction: column-reverse;
      align-items: center;
      justify-content: center;
    }

    .supplement-item-image img {
      display: block;
      width: auto;
      max-width: 85px;
      height: auto;
      margin-right: auto;
      margin-left: auto;
    }

    .grade-circle {
      width: 100px;
      height: 100px;
      background-size: 100%;
    }

    .grade-value {
      padding-top: 24px;
      font-size: 36px;
      letter-spacing: -0.75px;
      line-height: 38px;
    }

    .grade-label {
      font-size: 8px;
      letter-spacing: -0.5px;
      line-height: 10px;
    }

    .supplement-item-details {
      margin-top: 0;
    }

    .supplement-item-details .pros h5,
    .supplement-item-details .cons h5 {
      margin-bottom: 0;
      font-size: 22px;
      line-height: 38px;
      text-align: left;
    }

    .supplement-item-details .pros h5::after {
      display: none;
    }

    .supplement-item-details .pros,
    .supplement-item-details .cons {
      padding: 0 10px 10px;
    }

    .supplement-item-details .pros :global(ul li),
    .supplement-item-details .cons :global(ul li) {
      margin-bottom: 15px;
      font-size: 17px;
      line-height: 22px;
    }

    .supplement-item-details .pros :global(ul li:last-child),
    .supplement-item-details .cons :global(ul li:last-child) {
      margin-bottom: 15px;
    }

    .supplement-item-details .right :global(ul li:last-child) {
      margin-bottom: 0;
    }

    .supplement-item-details .pros :global(ul li strong),
    .supplement-item-details .cons :global(ul li strong) {
      font-weight: 600;
    }

    .supplement-item-details .choose h5 {
      font-size: 22px;
      line-height: 22px;
      letter-spacing: -0.5px;
    }

    .supplement-item-details .choose-copy :global(p) {
      margin-bottom: 16px;
      font-size: var(--paragraph-font-size-mobile, 18px);
      font-weight: 400;
      letter-spacing: -0.5px;
      line-height: 22px;
    }

    .supplement-item-details .choose-copy :global(strong) {
      font-weight: 600;
    }

    .supplement-item-details .choose .supplement-subtext {
      margin-bottom: 16px;
      font-size: calc(18px * 0.85);
      line-height: 22px;
    }

    .supplement-item-details .choose {
      padding: 12px 10px 0;
    }

    .supplement-item-details .choose p.remarks {
      margin-bottom: 14px;
      font-size: 9px;
      line-height: 12px;
    }

    .supplement-item-details .choose-cta__link {
      font-size: 21px;
      letter-spacing: -0.5px;
      line-height: 18px;
    }

    .supplement-item-details .cons h5::after {
      display: none;
    }
  }

  @media (max-width: 1010px) {
    .supplement-item-card {
      grid-template-columns: 20% 51% 29%;
    }

    .supplement-item-image {
      padding: 8px 4px;
    }

    .rating-label {
      width: 60%;
      font-size: 16px;
    }

    .rating-track {
      width: 40%;
    }
  }

  @media (max-width: 767px) {
    .supplement-item {
      margin-bottom: 10px;
    }

    .supplement-item-card {
      display: flex;
      overflow: visible;
      box-sizing: border-box;
      flex-direction: column;
      border: 0;
    }

    .supplement-item-mobile-title {
      position: relative;
      display: block;
      margin: 0 0 10px;
      padding-top: 25px;
      color: #000;
      font-size: 22px;
      font-weight: 500;
      letter-spacing: -0.5px;
      line-height: 22px;
      text-align: center;
    }

    .supplement-item-mobile-title::before {
      position: absolute;
      top: 12px;
      left: 50%;
      display: block;
      width: 48px;
      height: 3px;
      transform: translateX(-50%);
      background: #000;
      content: '';
    }

    .supplement-item-product-grade {
      display: flex;
      align-items: center;
      width: 100%;
    }

    .supplement-item-image,
    .supplement-item-grade,
    .supplement-item-ratings {
      grid-column: auto;
      grid-row: auto;
    }

    .supplement-item-image,
    .supplement-item-grade {
      float: none;
      flex: 0 0 49%;
      width: 49%;
      max-width: 49%;
      box-sizing: border-box;
    }

    .supplement-item-image {
      margin-bottom: 0;
      padding: 12px 12px 5px;
      border-right: 1px solid #ccc;
      text-align: center;
    }

    .supplement-item-image img {
      width: auto;
      max-width: 100%;
      height: auto;
      margin-top: 15px;
    }

    .supplement-item-grade {
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
      padding: 12px 8px;
    }

    .grade-circle {
      margin: 10px auto 0;
    }

    .supplement-item-ratings {
      width: 100%;
      border: 0;
    }

    .supplement-item-desktop-title {
      display: none;
    }

    .supplement-item-ratings ul {
      padding: 0;
      list-style: none;
      list-style-type: none;
    }

    .supplement-item-ratings li {
      padding: 5px 0;
    }

    .supplement-item-ratings li.active-rating {
      padding: 5px;
      border-width: 2px;
    }

    .rating-label {
      width: 75%;
      font-size: 16px;
      font-weight: 500;
    }

    .active-rating .rating-label {
      font-weight: 600;
    }

    .rating-track {
      width: 25%;
      background: transparent;
    }

    .rating-fill {
      width: 100% !important;
      padding: 0;
      color: #000;
      background: transparent;
      text-align: left;
    }

    .mobile-rating-track {
      display: block;
      width: 100%;
      height: 12px;
      overflow: hidden;
      background: #ccc;
    }

    .mobile-rating-fill {
      display: block;
      height: 100%;
      background: #990000;
    }
  }

  @media (max-width: 480px) {
    .supplement-item-mobile-title {
      font-size: 18px;
    }
  }
</style>
