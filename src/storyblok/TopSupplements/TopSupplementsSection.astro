---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok } = Astro.props;
---

<section {...storyblokEditable(blok)} class="top-supplements-section">
  <div>
    {blok.supplement_items?.map((item: any, index: number) => (
      <StoryblokComponent blok={item} rank={index + 1} />
    ))}
  </div>
</section>
