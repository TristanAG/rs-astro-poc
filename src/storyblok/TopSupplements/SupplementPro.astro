---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;
const prosIcon =
  'https://a.storyblok.com/f/293683996317857/28x28/8906970e00/pros.webp';
---

<li {...storyblokEditable(blok)}>
  <img
    src={prosIcon}
    alt=""
    width="28"
    height="28"
    class="pro-con-icon"
    aria-hidden="true"
  />
  <div class="pro-con-text">
    {blok.pro_lead && <span>{blok.pro_lead}</span>}
    {blok.pro}
  </div>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    list-style: none;
  }

  .pro-con-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
  }
</style>
