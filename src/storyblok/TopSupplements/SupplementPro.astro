---
import { storyblokEditable } from '@storyblok/astro';
import { applyLinkTarget, renderHtmlField } from '../../utils/renderHtmlField';

const { blok, rank = 1 } = Astro.props;
const openInNewWindow = rank > 1;
const { html: proLeadRaw } = renderHtmlField(blok.pro_lead);
const { html: proRaw } = renderHtmlField(blok.pro);
const proLead = applyLinkTarget(proLeadRaw, openInNewWindow);
const pro = applyLinkTarget(proRaw, openInNewWindow);
const prosIcon =
  'https://a.storyblok.com/f/293683996317857/28x28/8906970e00/pros.webp';
---

<li {...storyblokEditable(blok)}>
  <div
    class="pro-con-text"
    style={{ '--prosIconBackground': `url('${prosIcon}')` }}
  >
    {proLead && <span class="pro-lead" set:html={proLead} />}
    {pro && <span class="pro-copy" set:html={pro} />}
  </div>
</li>

<style>
  li {
    position: relative;
    padding-left: 44px;
    list-style: none;
  }

  .pro-con-text {
    position: relative;
  }

  .pro-con-text :global(p) {
    margin: 0;
    display: inline;
  }

  .pro-lead :global(strong),
  .pro-lead :global(b) {
    font-weight: 700;
  }

  .pro-con-text::before {
    content: '';
    position: absolute;
    top: 2px;
    left: -44px;
    width: 28px;
    height: 28px;
    background: var(--prosIconBackground) no-repeat center / contain;
  }

  @media (max-width: 639px) {
    .pro-con-text::before {
      top: 0;
    }
  }
</style>
