---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;
const prosIcon =
  'https://a.storyblok.com/f/293683996317857/28x28/8906970e00/pros.webp';
---

<li {...storyblokEditable(blok)}>
  <img
    src={prosIcon}
    alt=""
    width="28"
    height="28"
    class="pro-con-icon"
    aria-hidden="true"
  />
  {blok.pro_lead && <span>{blok.pro_lead}</span>}
  {blok.pro}
</li>

<style>
  li {
    position: relative;
    list-style: none;
  }

  .pro-con-icon {
    position: absolute;
    top: 2px;
    left: -30px;
    width: 28px;
    height: 28px;
  }

  @media (max-width: 767px) {
    .pro-con-icon {
      left: -26px;
    }
  }

  @media (max-width: 639px) {
    .pro-con-icon {
      top: 0;
    }
  }
</style>
