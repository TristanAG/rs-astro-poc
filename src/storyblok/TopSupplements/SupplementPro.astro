---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;
const prosIcon =
  'https://a.storyblok.com/f/293683996317857/28x28/8906970e00/pros.webp';
---

<li {...storyblokEditable(blok)}>
  <div
    class="pro-con-text"
    style={{ '--prosIconBackground': `url('${prosIcon}')` }}
  >
    {blok.pro_lead && <span>{blok.pro_lead}</span>}
    {blok.pro}
  </div>
</li>

<style>
  li {
    position: relative;
    padding-left: 44px;
    list-style: none;
  }

  .pro-con-text {
    position: relative;
  }

  .pro-con-text::before {
    content: '';
    position: absolute;
    top: 2px;
    left: -44px;
    width: 28px;
    height: 28px;
    background: var(--prosIconBackground) no-repeat center / contain;
  }

  @media (max-width: 639px) {
    .pro-con-text::before {
      top: 0;
    }
  }
</style>
