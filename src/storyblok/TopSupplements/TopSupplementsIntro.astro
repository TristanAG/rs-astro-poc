---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

const { blok } = Astro.props;
const copy = renderRichText(blok.copy);
const top_5_image = blok.top_5_image;
const titleId = blok.title_id?.trim() || undefined;
---

<section
  {...storyblokEditable(blok)}
  class:list={[titleId && 'target', blok.mobile_nav_target && 'mobmenu_target']}
  id={titleId}
>
  {top_5_image?.filename && (
    <img
      class="top-supplements-intro__image"
      src={top_5_image.filename}
      alt={top_5_image.alt || ''}
    />
  )}
  <div class="top-supplements-intro">
    {blok.title && <h2>{blok.title}</h2>}
    {blok.copy && <div set:html={copy}></div>}
  </div>
</section>

<style>
  .top-supplements-intro__image {
    display: block;
    margin: 0 auto;
    width: 20%;
    max-width: 100%;
    height: auto;
    margin-bottom: 8px;
  }

  .top-supplements-intro {
    position: relative;
  }

  h2 {
    font-weight: 500;
    font-size: 36px;
    line-height: 40px;
    color: #000;
    margin: 0 0 34px;
    text-align: center;
  }

  @media (max-width: 767px) {
    .top-supplements-intro {
      padding-top: 25px;
    }

    .top-supplements-intro::before {
      position: absolute;
      top: 12px;
      left: 50%;
      display: block;
      width: 48px;
      height: 3px;
      transform: translateX(-50%);
      background: #000;
      content: "";
    }

    h2 {
      font-size: 22px;
      line-height: 28px;
    }
  }

  @media (min-width: 640px) and (max-width: 767px) {
    h2 {
      font-size: 26px;
    }
  }
</style>
