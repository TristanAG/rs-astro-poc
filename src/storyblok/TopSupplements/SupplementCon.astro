---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;
const consIcon =
  'https://a.storyblok.com/f/293683996317857/28x28/d708f06658/cons.webp';
---

<li {...storyblokEditable(blok)}>
  <img
    src={consIcon}
    alt=""
    width="28"
    height="28"
    class="pro-con-icon"
    aria-hidden="true"
  />
  {blok.con_lead && <span>{blok.con_lead}</span>}
  {blok.con}
</li>

<style>
  li {
    position: relative;
    list-style: none;
  }

  .pro-con-icon {
    position: absolute;
    top: 0;
    left: -30px;
    width: 28px;
    height: 28px;
  }

  @media (max-width: 767px) {
    .pro-con-icon {
      left: -26px;
    }
  }
</style>
