---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;
const consIcon =
  'https://a.storyblok.com/f/293683996317857/28x28/d708f06658/cons.webp';
---

<li {...storyblokEditable(blok)}>
  <img
    src={consIcon}
    alt=""
    width="28"
    height="28"
    class="pro-con-icon"
    aria-hidden="true"
  />
  <div class="pro-con-text">
    {blok.con_lead && <span>{blok.con_lead}</span>}
    {blok.con}
  </div>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    list-style: none;
  }

  .pro-con-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
  }
</style>
