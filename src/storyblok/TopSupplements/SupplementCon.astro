---
import { storyblokEditable } from '@storyblok/astro';
import { renderHtmlField } from '../../utils/renderHtmlField';

const { blok } = Astro.props;
const { html: conLead } = renderHtmlField(blok.con_lead);
const { html: con } = renderHtmlField(blok.con);
const consIcon =
  'https://a.storyblok.com/f/293683996317857/28x28/d708f06658/cons.webp';
---

<li {...storyblokEditable(blok)}>
  <div
    class="pro-con-text"
    style={{ '--consIconBackground': `url('${consIcon}')` }}
  >
    {conLead && <span class="con-lead" set:html={conLead} />}
    {con && <span class="con-copy" set:html={con} />}
  </div>
</li>

<style>
  li {
    position: relative;
    padding-left: 44px;
    list-style: none;
  }

  .pro-con-text {
    position: relative;
  }

  .pro-con-text :global(p) {
    margin: 0;
    display: inline;
  }

  .con-lead :global(strong),
  .con-lead :global(b) {
    font-weight: 700;
  }

  .pro-con-text::before {
    content: '';
    position: absolute;
    top: 0;
    left: -44px;
    width: 28px;
    height: 28px;
    background: var(--consIconBackground) no-repeat center / contain;
  }
</style>
