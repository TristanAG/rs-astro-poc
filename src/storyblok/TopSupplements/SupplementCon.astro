---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;
const consIcon =
  'https://a.storyblok.com/f/293683996317857/28x28/d708f06658/cons.webp';
---

<li {...storyblokEditable(blok)}>
  <div class="pro-con-text">
    {blok.con_lead && <span>{blok.con_lead}</span>}
    {blok.con}
  </div>
</li>

<style define:vars={{ consIcon }}>
  li {
    position: relative;
    padding-left: 44px;
    list-style: none;
  }

  .pro-con-text {
    position: relative;
  }

  .pro-con-text::before {
    content: '';
    position: absolute;
    top: 0;
    left: -44px;
    width: 28px;
    height: 28px;
    background: url(var(--consIcon)) no-repeat center / contain;
  }
</style>
