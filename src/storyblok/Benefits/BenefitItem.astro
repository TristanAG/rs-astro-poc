---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

const { blok } = Astro.props;
const icon = blok.icon;
const title = renderRichText(blok.title);
---

<div class="benefit-item" {...storyblokEditable(blok)}>
  {icon?.filename && (
    <img
      class="benefit-icon"
      src={icon.filename}
      alt={icon.alt || ''}
      width="24"
      height="24"
    />
  )}
  {blok.title && <span class="benefit-title" set:html={title}></span>}
</div>

<style>
  .benefit-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .benefit-icon {
    flex: 0 0 auto;
    display: block;

    max-width: 66px;
    width: 100%;
    margin-right: 10px;
    padding: 6px 10px 10px 6px;

  }

  .benefit-title {
    flex: 1 1 auto;
  }

  .benefit-title > :global(h4) {
    font-family: 'Poppins', sans-serif;
    font-weight: 400;
    font-size: 22px;
    line-height: 1.3;
    margin: 0;
    padding: 0 0 15px;
    color: #000;
  }

  .benefit-title :global(p) {
    margin: 0;
    display: inline;
  }

  @media (max-width: 479px) {
    .benefit-title > :global(h4) {
      font-size: 16px;
    }
  }
</style>
