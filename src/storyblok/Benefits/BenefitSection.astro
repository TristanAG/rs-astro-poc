---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok } = Astro.props;

const titleId = blok.title_id?.trim() || undefined;
---

<section
  {...storyblokEditable(blok)}
  class:list={['benefit-section', titleId && 'target', blok.mobile_nav_target && 'mobmenu_target']}
  id={titleId}
>
  {blok.title && <h2>{blok.title}</h2>}

  <div class="benefit-items">
    {blok.benefit_item?.map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
</section>

<style>
  .benefit-section {
    background-color: #cceef2;
    padding: 1.25rem;
    border-radius: 0.5rem;
    margin-bottom: 30px;
  }

  .benefit-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h2 {
    font-weight: 500;
    font-size: 36px;
    line-height: 42px;
    color: #000;
    text-align: center;
    /* width: 350px; */
    margin: 0 auto 25px;
    max-width: 100%;
  }

  @media (max-width: 767px) {
    h2 {
      font-size: 24px;
      line-height: 26px;
    }
  }

  @media (max-width: 400px) {
    h2 {
      font-size: 21px;
    }
  }

  @media (max-width: 360px) {
    h2 {
      font-size: 20px;
    }
  }

  @media (max-width: 340px) {
    h2 {
      font-size: 16px;
    }
  }
</style>
