---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok } = Astro.props;
---

<section {...storyblokEditable(blok)} class="benefit-section">
  {blok.title && <h2>{blok.title}</h2>}

  <div class="benefit-items">
    {blok.benefit_item?.map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
</section>

<style>
  .benefit-section {
    background-color: #cceef2;
    padding: 1.25rem;
    border-radius: 0.5rem;
  }

  .benefit-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h2 {
    font-weight: 500;
    font-size: 36px;
    line-height: 42px;
    color: #000;
    text-align: center;
    width: 350px;
    margin: 0 auto 25px;
    max-width: 100%;
  }

  @media (max-width: 767px) {
    h2 {
      font-size: 26px;
      line-height: 42px;
    }
    
  }
</style>
