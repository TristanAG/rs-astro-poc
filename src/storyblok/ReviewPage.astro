---
import { storyblokEditable, type SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import FourFixedMobileNav from './TocNav/FourFixedMobileNav.astro';
import TocScrollSpy from './TocNav/TocScrollSpy.astro';
import TocSidebar from './TocNav/TocSidebar.astro';

const { blok } = Astro.props;

const FULL_WIDTH_COMPONENTS = new Set(['three_col_header']);
const TOC_COMPONENT = 'toc_nav';
const REVIEW_SECTION_COMPONENTS = new Set(['top_supplements_section']);

function partitionBody(body: SbBlokData[] = []) {
  const beforeFullWidth: SbBlokData[] = [];
  const fullWidthBlocks: SbBlokData[] = [];
  const afterFullWidth: SbBlokData[] = [];
  let tocBlock: SbBlokData | null = null;
  let passedFullWidth = false;

  for (const block of body) {
    if (block.component === TOC_COMPONENT) {
      tocBlock = block;
      continue;
    }

    if (FULL_WIDTH_COMPONENTS.has(block.component ?? '')) {
      fullWidthBlocks.push(block);
      passedFullWidth = true;
      continue;
    }

    if (passedFullWidth) {
      afterFullWidth.push(block);
    } else {
      beforeFullWidth.push(block);
    }
  }

  return { tocBlock, beforeFullWidth, fullWidthBlocks, afterFullWidth };
}

function partitionContainerBlocks(blocks: SbBlokData[] = []) {
  const leadingContentBlocks: SbBlokData[] = [];
  const reviewBlocks: SbBlokData[] = [];
  const trailingContentBlocks: SbBlokData[] = [];
  let passedReviewSection = false;

  for (const block of blocks) {
    if (REVIEW_SECTION_COMPONENTS.has(block.component ?? '')) {
      passedReviewSection = true;
      reviewBlocks.push(block);
    } else if (passedReviewSection) {
      trailingContentBlocks.push(block);
    } else {
      leadingContentBlocks.push(block);
    }
  }

  return { leadingContentBlocks, reviewBlocks, trailingContentBlocks };
}

const { tocBlock, beforeFullWidth, fullWidthBlocks, afterFullWidth } = partitionBody(
  blok.body ?? [],
);
const hasToc = Boolean(tocBlock);
const { leadingContentBlocks, reviewBlocks, trailingContentBlocks } =
  partitionContainerBlocks(afterFullWidth);
---

<div {...storyblokEditable(blok)}>
  {
    beforeFullWidth.length > 0 && (
      <div class="container container--content">
        {beforeFullWidth.map((nestedBlok) => (
          <StoryblokComponent blok={nestedBlok} />
        ))}
      </div>
    )
  }

  {fullWidthBlocks.map((block) => (
    <StoryblokComponent blok={block} />
  ))}

  {
    afterFullWidth.length > 0 &&
      (hasToc && tocBlock ? (
        <section class="main-container padding-top-30" id="content_main">
          <div class="container">
            <FourFixedMobileNav />

            <div class="sub-container">
              <TocSidebar blok={tocBlock} />

              <div class="left-contents" data-toc-content>
                {leadingContentBlocks.map((nestedBlok) => (
                  <StoryblokComponent blok={nestedBlok} />
                ))}
              </div>
            </div>

            {reviewBlocks.length > 0 && (
              <div class="review_details_sec">
                {reviewBlocks.map((nestedBlok) => (
                  <StoryblokComponent blok={nestedBlok} />
                ))}
              </div>
            )}

            {trailingContentBlocks.length > 0 && (
              <div class="review_details_sec">
                {trailingContentBlocks.map((nestedBlok) => (
                  <StoryblokComponent blok={nestedBlok} />
                ))}
              </div>
            )}
          </div>
        </section>
      ) : (
        <div class="container container--content">
          {afterFullWidth.map((nestedBlok) => (
            <StoryblokComponent blok={nestedBlok} />
          ))}
        </div>
      ))
  }

  {hasToc && <TocScrollSpy />}
</div>
