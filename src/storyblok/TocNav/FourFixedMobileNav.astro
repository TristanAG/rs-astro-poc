---
import type { SbBlokData } from '@storyblok/astro';
import { buildMobileNavItems } from './mobileNavTargets';

interface Props {
  mobileNavItems?: SbBlokData[];
}

const { mobileNavItems = [] } = Astro.props;

const items = buildMobileNavItems(mobileNavItems);
const revealTargetId = items[0]?.sectionId ?? '';
---

<nav
  class="four-fixed-nav"
  data-four-fixed-nav
  data-reveal-target={revealTargetId || undefined}
  aria-label="Article sections"
>
  <ul>
    {
      items.map((item) => (
        <li class:list={{ emphasized: item.emphasized }}>
          <a href={`#${item.sectionId}`} data-section-id={item.sectionId}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import { initFixedNavVisibility } from './tocScrollSpy';

  function bootFixedNavVisibility() {
    const nav = document.querySelector<HTMLElement>('[data-four-fixed-nav]');
    if (!nav) return;

    initFixedNavVisibility(nav.dataset.revealTarget ?? '');
  }

  bootFixedNavVisibility();
  document.addEventListener('astro:page-load', bootFixedNavVisibility);
</script>
