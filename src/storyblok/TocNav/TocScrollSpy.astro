<script>
  const ANCHOR_OFFSET = 75;
  const MOBILE_NAV_BREAKPOINT = 639;

  let lockedSectionId: string | null = null;

  function getScrollSpyOffset() {
    const fixedNav = document.querySelector<HTMLElement>('[data-four-fixed-nav].active');
    if (fixedNav) {
      return fixedNav.offsetHeight + 20;
    }

    return ANCHOR_OFFSET;
  }

  function getTocSections(tocLinks: HTMLAnchorElement[]) {
    return tocLinks.flatMap((link) => {
      const id = link.dataset.tocLink;
      if (!id) return [];

      const element = document.getElementById(id);
      return element ? [{ id, element, link }] : [];
    });
  }

  function getActiveSectionId(sections: { id: string; element: HTMLElement }[]) {
    if (sections.length === 0) return '';

    const activationLine = getScrollSpyOffset();

    for (let index = 0; index < sections.length; index += 1) {
      const section = sections[index];
      const top = section.element.getBoundingClientRect().top;
      const nextTop =
        index + 1 < sections.length
          ? sections[index + 1].element.getBoundingClientRect().top
          : Number.POSITIVE_INFINITY;

      if (top <= activationLine && nextTop > activationLine) {
        return section.id;
      }
    }

    const firstTop = sections[0].element.getBoundingClientRect().top;
    if (firstTop > activationLine) {
      return sections[0].id;
    }

    return sections[sections.length - 1].id;
  }

  function setActiveLink(activeId: string) {
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((link) => {
      const isActive = link.dataset.tocLink === activeId;
      link.classList.toggle('active', isActive);
      if (isActive) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }

  function updateTocState() {
    const tocNav = document.querySelector('[data-toc-nav]');
    if (!tocNav) return;

    if (lockedSectionId) {
      setActiveLink(lockedSectionId);
      return;
    }

    const tocLinks = Array.from(tocNav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    const sections = getTocSections(tocLinks);
    setActiveLink(getActiveSectionId(sections));
  }

  function waitForScrollEnd(onComplete: () => void) {
    let lastScrollY = window.scrollY;
    let unchangedFrames = 0;

    const check = () => {
      if (window.scrollY === lastScrollY) {
        unchangedFrames += 1;
        if (unchangedFrames >= 3) {
          onComplete();
          return;
        }
      } else {
        unchangedFrames = 0;
        lastScrollY = window.scrollY;
      }

      requestAnimationFrame(check);
    };

    requestAnimationFrame(check);
  }

  function scrollToSection(link: HTMLAnchorElement) {
    const sectionId = link.dataset.tocLink || link.hash.slice(1);
    const target = document.getElementById(sectionId);
    if (!sectionId || !target) return;

    lockedSectionId = sectionId;
    setActiveLink(sectionId);

    const top = window.scrollY + target.getBoundingClientRect().top - ANCHOR_OFFSET;
    const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    window.scrollTo({ top, behavior });

    const releaseLock = () => {
      lockedSectionId = null;
      updateTocState();
    };

    if (behavior === 'auto') {
      releaseLock();
      return;
    }

    waitForScrollEnd(releaseLock);
  }

  function initializeToc() {
    const tocNav = document.querySelector('[data-toc-nav]');
    if (!tocNav || !(tocNav instanceof HTMLElement) || tocNav.dataset.tocInitialized === 'true') return;

    tocNav.dataset.tocInitialized = 'true';

    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        scrollToSection(link);
      });
    });

    updateTocState();
  }

  let animationFrame = 0;

  function scheduleTocUpdate() {
    if (!animationFrame) {
      animationFrame = window.requestAnimationFrame(() => {
        animationFrame = 0;
        updateTocState();
      });
    }
  }

  window.addEventListener('scroll', scheduleTocUpdate, { passive: true });
  window.addEventListener('resize', scheduleTocUpdate);
  document.addEventListener('astro:page-load', initializeToc);
  initializeToc();
</script>
