---
import { storyblokEditable } from '@storyblok/astro';

const { blok } = Astro.props;

const sectionId = blok.section_id?.trim();
const label = String(blok.nav_label ?? blok.label ?? '').trim();
const labelSecondLine = String(blok.nav_label_second_line ?? '').trim();
---

<span
  {...storyblokEditable(blok)}
  hidden
  aria-hidden="true"
  data-section-id={sectionId || undefined}
>
  {
    labelSecondLine ? (
      <>
        <span>{label}</span>
        <span>{labelSecondLine}</span>
      </>
    ) : (
      label
    )
  }
</span>
