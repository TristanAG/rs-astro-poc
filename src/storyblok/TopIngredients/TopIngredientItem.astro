---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

const { blok } = Astro.props;
const copy = renderRichText(blok.copy);
const editors_note = renderRichText(blok.editors_note);
const editors_note_highlighted_text_color = blok.editors_note_highlighted_text_color;
---

<div {...storyblokEditable(blok)} class="ingredient-item">
  <p class="ingredient-item-text">
    {blok.title && <strong class="ingredient-title">{blok.title} </strong>}
    {blok.copy && <span class="ingredient-copy" set:html={copy} />}
    {blok.editors_note_highlighted_text && (
      <span class="editors-note" style={`background-color: ${editors_note_highlighted_text_color};`}>{blok.editors_note_highlighted_text}</span>
    )}
    &nbsp;
    {blok.editors_note && <span class="editors-note-text" set:html={editors_note} />}
  </p>
</div>

<style>
  .ingredient-title {
    font-family: 'poppins', sans-serif;
    font-weight: 400;
    margin: 0;
    font-size: 26px;
    line-height: 26px;
    padding-left: 15px;
    text-align: left;
  }

  .ingredient-copy :global(p),
  .editors-note-text :global(p) {
    display: inline;
    margin: 0;
  }
  .editors-note {
    font-style: italic;
    font-weight: 700;
  }
</style>
