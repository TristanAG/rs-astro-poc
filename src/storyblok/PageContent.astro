---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

const { blok } = Astro.props;

const content_area_one = renderRichText(blok.content_area_one);
const content_area_two = renderRichText(blok.content_area_two);
const content_area_three = renderRichText(blok.content_area_three);

const contentAreaOneId = blok.content_area_one_id?.trim() || undefined;
const howToTitleId = blok.how_to_title_id?.trim() || undefined;
const whatAreTheyAboutTitleId = blok.what_are_they_about_title_id?.trim() || undefined;
---

<section {...storyblokEditable(blok)} class="page-content">
  {content_area_one && (
    <div
      id={contentAreaOneId}
      class:list={[contentAreaOneId && 'target']}
      set:html={content_area_one}
    />
  )}

  {blok.how_to_title && (
    <h3 id={howToTitleId} class:list={[howToTitleId && 'target']}>
      {blok.how_to_title}
    </h3>
  )}

  <div set:html={content_area_two} />

  {blok.what_are_they_about_title && (
    <h3 id={whatAreTheyAboutTitleId} class:list={[whatAreTheyAboutTitleId && 'target']}>
      {blok.what_are_they_about_title}
    </h3>
  )}

  <div set:html={content_area_three} />
</section>

<style>
  .page-content {
    padding-left: 10px;
    padding-right: 10px;
  }

