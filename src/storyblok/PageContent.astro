---
import { storyblokEditable, renderRichText } from '@storyblok/astro';
import { renderHtmlField } from '../utils/renderHtmlField';

const { blok } = Astro.props;

const content_area_one = renderRichText(blok.content_area_one);
const content_area_two = renderRichText(blok.content_area_two);
const content_area_three = renderRichText(blok.content_area_three);
const what_are_they_about_title = renderHtmlField(blok.what_are_they_about_title);
---

<section {...storyblokEditable(blok)} class="page-content">
    <div set:html={content_area_one} />
   
    <h3>{blok.how_to_title}</h3>

    <div set:html={content_area_two} />

    {what_are_they_about_title.html && (
        <div class="html-field" set:html={what_are_they_about_title.html} />
    )}
    <!-- {what_are_they_about_title.css && (
        <style is:global set:html={what_are_they_about_title.css} />
    )} -->
    
    <div set:html={content_area_three} />
</section>

<style>
  .page-content {
    margin-top: 30px;
    padding-left: 10px;
    padding-right: 10px;
  }

  h3,
  .html-field :global(h3) {
    font-size: 36px;
    color: #000;
    text-align: center;
    font-weight: 500;
    margin-bottom: 20px;
    line-height: 1.1;
  }

  @media (max-width: 767px) {
    h3,
    .html-field :global(h3) {
        font-size: 24px;
        line-height: 28px;
    }
}
</style>