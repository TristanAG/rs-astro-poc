---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

const { blok } = Astro.props;

const content_area_one = renderRichText(blok.content_area_one);
const content_area_two = renderRichText(blok.content_area_two);
const content_area_three = renderRichText(blok.content_area_three);
---

<section
  {...storyblokEditable(blok)}
  class:list={['page-content', blok.section_id && 'target', blok.mobile_nav_target && 'mobmenu_target']}
  id={blok.section_id?.trim() || undefined}
>
    <div set:html={content_area_one} />
   
    <h3>{blok.how_to_title}</h3>

    <div set:html={content_area_two} />

    <h3>{blok.what_are_they_about_title}</h3>
    
    <div set:html={content_area_three} />
</section>

<style>
  .page-content {
    margin-top: 30px;
    padding-left: 10px;
    padding-right: 10px;
  }

