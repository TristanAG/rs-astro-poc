---
import { storyblokEditable, renderRichText } from '@storyblok/astro';

const { blok } = Astro.props;
const copy = renderRichText(blok.copy);
---

<div class="avoid-item">
  <h3 class="red">{blok.title}</h3>

  <div class="avoid-item-text" set:html={copy}></div>
    
</div>

<style>
    .red {
      color: #ff0000;
      font-weight: 500;
      font-size: 26px;
      line-height: 26px;
      margin-bottom: 15px;
    }
    .avoid-item-text {
      /* font-weight: 400;
      font-size: 19px;
      line-height: 28px;
      color: #000;
      margin-bottom: 26px; */
    }

    .avoid-item-text :global(p) {
      font-weight: 400;
      font-size: 19px;
      line-height: 28px;
      color: #000;
      margin-bottom: 26px;
    }
</style>