---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok } = Astro.props;
---

<section
  {...storyblokEditable(blok)}
  class:list={['avoid-section', blok.section_id && 'target', blok.mobile_nav_target && 'mobmenu_target']}
  id={blok.section_id?.trim() || undefined}
>
  {blok.title && <h2>{blok.title}</h2>}

  <h2>
    {blok.title_before}
    &nbsp;<span class="red">{blok.title_highlight}</span>&nbsp;
    {blok.title_after}
  </h2>

  <div>
    {blok.items?.map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
</section>

<style>
    .avoid-section {

    }

    .red {
        color: #ff0000;
    }

    h2 {
        position: relative;
        padding-top: 15px;
        margin: 0 auto 25px;;
        width: 450px;
        max-width: 100%;
        font-weight: 500;
    }

    h2::before {
        content: "";
        position: absolute;
        width: 46px;
        height: 3px;
        background: #000;
        top: -5px;
        left: 50%;
        transform: translateX(-50%);
    }
</style>