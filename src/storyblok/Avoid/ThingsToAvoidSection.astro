---
import { storyblokEditable } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

const { blok } = Astro.props;

const hasCompositeTitle = blok.title_before || blok.title_highlight || blok.title_after;
const titleId = blok.title_id?.trim() || undefined;
---

<section {...storyblokEditable(blok)} class="avoid-section">
  {blok.title && <h2>{blok.title}</h2>}

  {hasCompositeTitle && (
    <h2 id={titleId} class:list={[titleId && 'target']}>
      {blok.title_before}
      &nbsp;<span class="red">{blok.title_highlight}</span>&nbsp;
      {blok.title_after}
    </h2>
  )}

  <div>
    {blok.items?.map((item) => (
      <StoryblokComponent blok={item} />
    ))}
  </div>
</section>

<style>
    .avoid-section {

    }

    .red {
        color: #ff0000;
    }

    h2 {
        position: relative;
        padding-top: 15px;
        margin: 0 auto 25px;;
        width: 450px;
        max-width: 100%;
        font-weight: 500;
    }

    h2::before {
        content: "";
        position: absolute;
        width: 46px;
        height: 3px;
        background: #000;
        top: -5px;
        left: 50%;
        transform: translateX(-50%);
    }
</style>
