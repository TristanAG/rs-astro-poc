---
import '../styles/global.css';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import SiteFooter from './SiteFooter.astro';

const { title, settings } = Astro.props;
const logo = settings?.logo;
const headerText = settings?.header_text;

const buyingGuideNavLinks = settings?.buying_guide_links ?? [];
const latestArticlesNavLinks = settings?.latest_article_links ?? [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      href="https://fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <!-- Osano Consent Management Platform -->
    <script src="https://cmp.osano.com/AzZnQ2UMfvw0P38GQ/55acc56b-d3d7-489e-8db9-e862373495a8/osano.js"></script>
  </head>

  <body>
    <div class="container container--header">
      <header class="site-header">
        <a href="/" class="site-logo">
          {logo?.filename && (
            <img src={logo.filename} alt={logo.alt || settings.site_name} width="350" />
          )}
        </a>
        <p class="header-text">{headerText}</p>

        <details class="nav-menu">
          <summary class="nav-menu__toggle" aria-label="Open menu">
            <span class="nav-menu__icon" aria-hidden="true"></span>
          </summary>
          <nav class="nav-menu__dropdown" aria-label="Mobile navigation">
            <div class="nav-menu__dropdown-inner">
              <details class="nav-menu__section">
                <summary class="nav-menu__section-toggle" role="button">
                  <span class="nav-menu__section-label">Buying Guides</span>
                  <span class="nav-menu__section-arrow" aria-hidden="true"></span>
                </summary>
                <div class="nav-menu__submenu-panel">
                  <ul class="nav-menu__submenu">
                    {buyingGuideNavLinks.map((item) => (
                      <li>
                        <StoryblokComponent blok={item} />
                      </li>
                    ))}
                  </ul>
                </div>
              </details>

              <details class="nav-menu__section">
                <summary class="nav-menu__section-toggle" role="button">
                  <span class="nav-menu__section-label">Latest Articles</span>
                  <span class="nav-menu__section-arrow" aria-hidden="true"></span>
                </summary>
                <div class="nav-menu__submenu-panel">
                  <ul class="nav-menu__submenu">
                    {latestArticlesNavLinks.map((item) => (
                      <li>
                        <StoryblokComponent blok={item} />
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            </div>
          </nav>
        </details>
      </header>
    </div>

    <nav class="site-nav">
      <div class="container container--nav">
        <a href="/">Latest Articles</a>
        <a href="/">Buying Guides</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <SiteFooter />

    <script>
      const menu = document.querySelector('.nav-menu');
      const dropdown = menu?.querySelector('.nav-menu__dropdown');
      const dropdownInner = dropdown?.querySelector('.nav-menu__dropdown-inner');
      const toggle = menu?.querySelector('.nav-menu__toggle');

      let isMenuAnimating = false;
      let menuTransitionTimer = null;
      let cachedMenuHeight = 0;
      let skipToggleHandler = false;

      const MENU_TRANSITION_MS = 350;

      function measureDropdownHeight() {
        if (!(dropdownInner instanceof HTMLElement)) return cachedMenuHeight;

        const height = dropdownInner.getBoundingClientRect().height || dropdownInner.scrollHeight;
        if (height > 0) cachedMenuHeight = height;
        return height || cachedMenuHeight;
      }

      function setDropdownHeight(height, animate) {
        if (!(dropdown instanceof HTMLElement)) return;

        dropdown.style.transition = animate ? `max-height ${MENU_TRANSITION_MS}ms ease` : 'none';
        dropdown.style.maxHeight = `${height}px`;

        if (!animate) {
          dropdown.offsetHeight;
        }
      }

      function beginMenuAnimation() {
        isMenuAnimating = true;
        clearTimeout(menuTransitionTimer);
      }

      function endMenuAnimation(callback) {
        menuTransitionTimer = window.setTimeout(() => {
          isMenuAnimating = false;
          callback?.();
        }, MENU_TRANSITION_MS);
      }

      function openMenu() {
        if (!(menu instanceof HTMLDetailsElement) || !(dropdown instanceof HTMLElement)) return;

        beginMenuAnimation();
        const targetHeight = measureDropdownHeight();
        setDropdownHeight(0, false);
        setDropdownHeight(targetHeight, true);
        endMenuAnimation();
      }

      function closeMenu(onComplete) {
        if (!(dropdown instanceof HTMLElement)) return;

        beginMenuAnimation();
        const startHeight = measureDropdownHeight();
        setDropdownHeight(startHeight, false);
        setDropdownHeight(0, true);
        endMenuAnimation(onComplete);
      }

      function syncParentMenuHeight() {
        if (
          isMenuAnimating ||
          !(menu instanceof HTMLDetailsElement) ||
          !(dropdown instanceof HTMLElement) ||
          !menu.open
        ) {
          return;
        }

        setDropdownHeight(measureDropdownHeight(), true);
      }

      if (menu instanceof HTMLDetailsElement && dropdown instanceof HTMLElement) {
        setDropdownHeight(0, false);

        toggle?.addEventListener('click', (event) => {
          if (!(menu instanceof HTMLDetailsElement) || isMenuAnimating) return;

          if (menu.open) {
            event.preventDefault();
            closeMenu(() => {
              skipToggleHandler = true;
              menu.open = false;
            });
          }
        });

        menu.addEventListener('toggle', () => {
          if (skipToggleHandler) {
            skipToggleHandler = false;
            setDropdownHeight(0, false);
            return;
          }

          if (menu.open) {
            openMenu();
          }
        });

        menu.querySelectorAll('.nav-menu__section').forEach((section) => {
          section.addEventListener('toggle', syncParentMenuHeight);
        });

        if (dropdownInner instanceof HTMLElement) {
          new ResizeObserver(() => {
            syncParentMenuHeight();
          }).observe(dropdownInner);
        }
      }

      document.addEventListener('click', (event) => {
        if (!(menu instanceof HTMLDetailsElement) || !menu.open || isMenuAnimating) return;
        if (event.target instanceof Node && !menu.contains(event.target)) {
          closeMenu(() => {
            skipToggleHandler = true;
            menu.open = false;
          });
        }
      });
    </script>
  </body>
</html>

<style>
  @media (max-width: 1200px) {
    .container--header,
    .container--nav {
      padding-left: 8.3%;
    }
  }

  @media (min-width: 1200px) {
    .container--header {
      max-width: 1000px;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .site-nav {
      background-color: transparent;
      padding-left: 0;
    }

    .container--nav {
      max-width: 1000px;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
      background-color: #444;
      box-sizing: border-box;
    }
  }

  .container--content {
    padding-top: 0;
  }

  .container--nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .nav-menu {
    display: none;
    position: relative;
    margin-bottom: 0;
  }

  .nav-menu__toggle {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: #000;
    -webkit-appearance: none;
    appearance: none;
  }

  .nav-menu__toggle::-webkit-details-marker {
    display: none;
  }

  .nav-menu__toggle::marker {
    content: '';
  }

  .nav-menu__toggle::after,
  .nav-menu[open] > .nav-menu__toggle::after {
    display: none;
    content: none;
  }

  .nav-menu[open] > .nav-menu__toggle {
    margin-bottom: 0;
  }

  .nav-menu__icon,
  .nav-menu__icon::before,
  .nav-menu__icon::after {
    display: block;
    width: 1.35rem;
    height: 3px;
    background: currentColor;
    border-radius: 1px;
  }

  .nav-menu__icon {
    position: relative;
  }

  .nav-menu__icon::before,
  .nav-menu__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-menu__icon::before {
    top: -7px;
  }

  .nav-menu__icon::after {
    top: 7px;
  }

  .nav-menu__dropdown {
    display: block;
    background: #69c;
    position: absolute;
    top: 60px;
    width: 100%;
    left: 0;
    z-index: 999;
    padding: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 350ms ease;
    --pico-accordion-close-summary-color: #fff;
    --pico-accordion-open-summary-color: #fff;
    --pico-accordion-active-summary-color: #fff;
    --pico-color: #fff;
    --pico-muted-color: #fff;
    --pico-primary: #fff;
    --pico-primary-hover: #fff;
  }

  .nav-menu__dropdown-inner {
    padding: 0;
  }

  .nav-menu__section {
    margin-bottom: 0;
    border: none;
  }

  .nav-menu__section-toggle {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0.75rem 0 0.75rem 15px;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    outline: none;
    text-align: left;
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    line-height: 30px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #fff;
    --pico-box-shadow: none;
    --pico-button-box-shadow: none;
    --pico-button-hover-box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
  }

  .nav-menu__section-toggle::-webkit-details-marker {
    display: none;
  }

  .nav-menu__section-toggle::marker {
    content: '';
  }

  .nav-menu__section-toggle::after,
  .nav-menu__section[open] > .nav-menu__section-toggle::after {
    display: none;
    content: none;
  }

  .nav-menu__section[open] > .nav-menu__section-toggle {
    margin-bottom: 0;
  }

  .nav-menu__section-toggle,
  .nav-menu__section[open] > .nav-menu__section-toggle,
  .nav-menu__section[open] > .nav-menu__section-toggle:not(:focus),
  .nav-menu__section-toggle:hover,
  .nav-menu__section-toggle:active,
  .nav-menu__section-toggle:focus,
  .nav-menu__section-toggle:focus-visible {
    color: #fff;
    background: transparent;
    border: 0;
    box-shadow: none;
    outline: none;
    --pico-box-shadow: none;
  }

  .nav-menu__section-label {
    flex: 1 1 auto;
  }

  .nav-menu__section-arrow {
    flex: 0 0 auto;
    width: 0;
    height: 0;
    margin-left: auto;
    border-left: 15px solid transparent;
    border-right: 15px solid transparent;
    border-top: 18px solid #fff;
    transition: transform 350ms ease;
    margin-right: 6px;
  }

  .nav-menu__section[open] .nav-menu__section-arrow {
    transform: rotate(180deg);
  }

  .nav-menu__submenu-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 350ms ease;
  }

  .nav-menu__section[open] .nav-menu__submenu-panel {
    max-height: 16rem;
  }

  .nav-menu__submenu {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-menu__submenu li {
    display: block;
    width: 100%;
    margin: 0;

    border-bottom: 1px solid #fff;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 15px;
  }

  .nav-menu__submenu li::before {
    float: none;
    content: none;
    display: none;
  }

  .nav-menu__submenu :global(a),
  .nav-menu__submenu :global(a:hover),
  .nav-menu__submenu :global(a:active),
  .nav-menu__submenu :global(a:focus),
  .nav-menu__submenu :global(a:focus-visible),
  .nav-menu__submenu :global(a:visited),
  .nav-menu__submenu :global(a[aria-current]:not([aria-current=false])) {
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem 25px;
    text-decoration: none;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
    --pico-color: #fff;
  }

  /*
    Below 999px: lock the left inset that 8.3% had at 999px (~82.9px),
    then collapse it linearly to 0 by 767px so the container edge
    moves flush with the content instead of keeping a proportional gap.
  */
  @media (max-width: 999px) {
    .container--header,
    .container--nav {
      padding-left: max(0px, calc((100vw - 767px) * 82.917px / 232px));
    }
  }

  @media (max-width: 767px) {
    .container--header {
      position: relative;
      padding-left: 0;
      padding-right: 3.5rem;
    }

    .site-logo img {
      width: 235px;
    }

    .header-text {
      width: 240px;
    }

    .container--nav {
      display: none;
    }
  }

  .site-header {
    display: flex;
    /* align-items: center; */
    flex-direction: column;
    justify-content: space-between;
    /* gap: 1rem; */
    padding-left: 15px;
  }

  .header-text {
    font-size: 12px;
    line-height: 1.45;
    font-weight: 400;
    font-style: normal;
    margin-bottom: 2px;
    display: block;
    color: #000;
    text-align: left;
  }

  .site-nav {
    width: 100%;
    background-color: #444;
    margin-bottom: .5rem;
    padding-left: 15px;
  }

  .site-nav a {
    color: #fff;
    text-decoration: none;
    font-weight: 400;
    font-size: 14px;
    line-height: 14px;
  }

  .site-logo {
    display: inline-flex;
    line-height: 0;
  }

  .site-logo img {
    display: block;
    height: auto;
  }

  @media (max-width: 767px) {
    .nav-menu {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      position: absolute;
      top: 0.5rem;
      left: 0;
      right: 0;
      width: 100%;
      padding: 0 0.7rem 0 0;
      z-index: 1;
    }

    .nav-menu__dropdown {
      top: 60px;
      left: 0;
      width: 100%;
    }
  }
</style>
