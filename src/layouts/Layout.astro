---
import '../styles/global.css';

const { title, settings } = Astro.props;
const logo = settings?.logo;
const headerText = settings?.header_text;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>

  <body>
    <div class="container container--header">
      <header class="site-header">
        <a href="/" class="site-logo">
          {logo?.filename && (
            <img src={logo.filename} alt={logo.alt || settings.site_name} width="350" />
          )}
        </a>
        <p class="header-text">{headerText}</p>

        <details class="nav-menu">
          <summary class="nav-menu__toggle" aria-label="Open menu">
            <span class="nav-menu__icon" aria-hidden="true"></span>
          </summary>
          <nav class="nav-menu__dropdown" aria-label="Mobile navigation">
            <div class="nav-menu__dropdown-inner">
              <details class="nav-menu__section">
                <summary class="nav-menu__section-toggle">
                  <span class="nav-menu__section-label">Buying Guides</span>
                  <span class="nav-menu__section-arrow" aria-hidden="true"></span>
                </summary>
                <div class="nav-menu__submenu-panel">
                  <ul class="nav-menu__submenu">
                    <li><a href="#">Dummy Link 1</a></li>
                    <li><a href="#">Dummy Link 2</a></li>
                    <li><a href="#">Dummy Link 3</a></li>
                  </ul>
                </div>
              </details>

              <details class="nav-menu__section">
                <summary class="nav-menu__section-toggle">
                  <span class="nav-menu__section-label">Latest Articles</span>
                  <span class="nav-menu__section-arrow" aria-hidden="true"></span>
                </summary>
                <div class="nav-menu__submenu-panel">
                  <ul class="nav-menu__submenu">
                    <li><a href="#">Dummy Link 1</a></li>
                    <li><a href="#">Dummy Link 2</a></li>
                    <li><a href="#">Dummy Link 3</a></li>
                  </ul>
                </div>
              </details>
            </div>
          </nav>
        </details>
      </header>
    </div>

    <nav class="site-nav">
      <div class="container container--nav">
        <a href="/">Latest Articles</a>
        <a href="/">Buying Guides</a>
      </div>
    </nav>

    <div class="container container--content">
      <main>
        <slot />
      </main>

      <footer>
        <small>{settings.footer_text}</small>
      </footer>
    </div>

    <script>
      const menu = document.querySelector('.nav-menu');
      const dropdown = menu?.querySelector('.nav-menu__dropdown');

      function animateParentMenu(isOpen) {
        if (!(menu instanceof HTMLDetailsElement) || !(dropdown instanceof HTMLElement)) return;

        dropdown.style.transition = 'max-height 350ms ease';

        if (isOpen) {
          dropdown.style.maxHeight = '0';
          requestAnimationFrame(() => {
            dropdown.style.maxHeight = `${dropdown.scrollHeight}px`;
          });
          return;
        }

        dropdown.style.maxHeight = `${dropdown.scrollHeight}px`;
        requestAnimationFrame(() => {
          dropdown.style.maxHeight = '0';
        });
      }

      function syncParentMenuHeight() {
        if (!(menu instanceof HTMLDetailsElement) || !(dropdown instanceof HTMLElement) || !menu.open) {
          return;
        }

        dropdown.style.maxHeight = `${dropdown.scrollHeight}px`;
      }

      if (menu instanceof HTMLDetailsElement && dropdown instanceof HTMLElement) {
        dropdown.style.maxHeight = '0';

        menu.addEventListener('toggle', () => {
          animateParentMenu(menu.open);
        });

        menu.querySelectorAll('.nav-menu__section').forEach((section) => {
          section.addEventListener('toggle', syncParentMenuHeight);
        });
      }

      document.addEventListener('click', (event) => {
        if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;
        if (event.target instanceof Node && !menu.contains(event.target)) {
          menu.open = false;
        }
      });
    </script>
  </body>
</html>

<style>
  .container--header {
    padding-left: 8.3%;
  }

  .container--content {
    padding-top: 0;
  }

  .container--nav {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    padding-left: 8.3%;
  }

  .nav-menu {
    display: none;
    position: relative;
    margin-bottom: 0;
  }

  .nav-menu__toggle {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    margin: 0;
    padding: 0;
    border: none;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    color: #000;
    -webkit-appearance: none;
    appearance: none;
  }

  .nav-menu__toggle::-webkit-details-marker {
    display: none;
  }

  .nav-menu__toggle::marker {
    content: '';
  }

  .nav-menu__toggle::after,
  .nav-menu[open] > .nav-menu__toggle::after {
    display: none;
    content: none;
  }

  .nav-menu[open] > .nav-menu__toggle {
    margin-bottom: 0;
  }

  .nav-menu__icon,
  .nav-menu__icon::before,
  .nav-menu__icon::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  .nav-menu__icon {
    position: relative;
  }

  .nav-menu__icon::before,
  .nav-menu__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-menu__icon::before {
    top: -6px;
  }

  .nav-menu__icon::after {
    top: 6px;
  }

  .nav-menu__dropdown {
    display: block;
    background: #69c;
    position: absolute;
    top: 22px;
    width: 100%;
    left: 0;
    z-index: 999;
    padding: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 350ms ease;
  }

  .nav-menu__dropdown-inner {
    padding: 0;
  }

  .nav-menu__section {
    margin-bottom: 0;
    border-bottom: 1px solid #fff;
  }

  .nav-menu__section-toggle {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 0.75rem 0 0.75rem 25px;
    border: 0;
    background: transparent;
    text-align: left;
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    line-height: 30px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #fff;
    -webkit-appearance: none;
    appearance: none;
  }

  .nav-menu__section-toggle::-webkit-details-marker {
    display: none;
  }

  .nav-menu__section-toggle::marker {
    content: '';
  }

  .nav-menu__section-toggle::after,
  .nav-menu__section[open] > .nav-menu__section-toggle::after {
    display: none;
    content: none;
  }

  .nav-menu__section[open] > .nav-menu__section-toggle {
    margin-bottom: 0;
  }

  .nav-menu__section-label {
    flex: 1 1 auto;
  }

  .nav-menu__section-arrow {
    flex: 0 0 auto;
    width: 0;
    height: 0;
    margin-left: auto;
    border-left: 9px solid transparent;
    border-right: 9px solid transparent;
    border-top: 12px solid currentColor;
    transition: transform 350ms ease;
  }

  .nav-menu__section[open] .nav-menu__section-arrow {
    transform: rotate(180deg);
  }

  .nav-menu__submenu-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 350ms ease;
  }

  .nav-menu__section[open] .nav-menu__submenu-panel {
    max-height: 16rem;
  }

  .nav-menu__submenu {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-menu__submenu li {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid #fff;
  }

  .nav-menu__submenu li::before {
    float: none;
    content: none;
    display: none;
  }

  .nav-menu__submenu a {
    display: block;
    box-sizing: border-box;
    width: 100%;
    padding: 0.75rem 25px;
    text-decoration: none;
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #fff;
  }

  /*
    Below 999px: lock the left inset that 8.3% had at 999px (~82.9px),
    then collapse it linearly to 0 by 767px so the container edge
    moves flush with the content instead of keeping a proportional gap.
  */
  @media (max-width: 999px) {
    .container--header,
    .container--nav {
      padding-left: max(0px, calc((100vw - 767px) * 82.917px / 232px));
    }
  }

  @media (max-width: 767px) {
    .container--header {
      padding-left: 0;
      padding-right: 3.5rem;
    }

    .container--nav {
      display: none;
    }

    .nav-menu {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      padding: 0.5rem 0.5rem 0;
      z-index: 1000;
    }
  }

  .site-header {
    display: flex;
    /* align-items: center; */
    flex-direction: column;
    justify-content: space-between;
    /* gap: 1rem; */
  }

  .header-text {
    font-size: 12px;
    line-height: 1.45;
    font-weight: 400;
    font-style: normal;
    margin-bottom: 2px;
    display: block;
    color: #000;
    text-align: left;
  }

  .site-nav {
    width: 100%;
    background-color: #444;
    margin-bottom: 2rem;
  }

  .site-nav a {
    color: #fff;
    text-decoration: none;
    font-weight: 400;
    font-size: 14px;
    line-height: 14px;
  }

  .site-logo {
    display: inline-flex;
    line-height: 0;
  }

  .site-logo img {
    display: block;
    height: auto;
  }
</style>
